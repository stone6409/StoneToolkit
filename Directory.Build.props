<Project>

  <!-- 版本号统一维护入口 -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>stone6409</Authors>
    <Company>StoneToolkit</Company>
    <Product>StoneToolkit</Product>
    <RepositoryType>git</RepositoryType>
    <PackageTags>wpf;toolkit;utilities</PackageTags>
  </PropertyGroup>

  <!-- 默认不打包；仅 StoneToolkit.* 类库可打包 -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('StoneToolkit.'))">
    <IsPackable>true</IsPackable>
  </PropertyGroup>

</Project>
