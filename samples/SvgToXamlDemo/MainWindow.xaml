        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SvgToXamlDemo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="240">
    <Grid>
        <StackPanel>
            <Button x:Name="SvgFileToXamlButton" Content="SvgFileToXaml" Click="SvgFileToXamlButton_Click" />
