<Window x:Class="WpfFontExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfFontExample"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <local:WpfText x:Name="wpfText" Content="中文" Background="Blue" Foreground="White">
            <local:WpfText.Font>
                <local:Font FontFamily="微软雅黑" FontSize="20">
                </local:Font>
            </local:WpfText.Font>
        </local:WpfText>
        <Button x:Name="TestProperty" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Click="TestProperty_Click">Test Property</Button>
    </Grid>
</Window>
