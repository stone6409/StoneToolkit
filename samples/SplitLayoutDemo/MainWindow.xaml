<Window x:Class="SplitLayoutDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sc="clr-namespace:StoneToolkit.WpfControl.SplitLayoutControl;assembly=StoneToolkit.WpfControl"
        Title="分栏布局控件示例（工控 HMI）"
        Height="720"
        Width="1180"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="保存版面" Command="{Binding SaveCommand}" Padding="8,2" />
                <Button Content="加载版面" Command="{Binding LoadCommand}" Padding="8,2" />
                <Button Content="恢复默认" Command="{Binding ResetCommand}" Padding="8,2" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- 分栏布局控件：Root 双向绑定，右键任意格子可分栏 / 关闭 / 切换内容 -->
            <sc:SplitLayoutControl x:Name="LayoutControl"
                                   Grid.Column="0"
                                   Margin="4"
                                   Root="{Binding LayoutRoot, Mode=TwoWay}" />

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#C7CFDA" />

            <DockPanel Grid.Column="2" Margin="4">
                <TextBlock DockPanel.Dock="Top"
                           Text="版面 JSON（只读展示）"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBox Text="{Binding LayoutJson, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
