<UserControl x:Class="SplitLayoutDemo.Contents.Views.DeviceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataGrid x:Name="DeviceGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              FontSize="12"
              RowHeaderWidth="0">
        <DataGrid.Columns>
            <DataGridTextColumn Header="设备" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="0.7*" />
            <DataGridTextColumn Header="运行时长" Binding="{Binding Runtime}" Width="*" />
            <DataGridTextColumn Header="产量" Binding="{Binding Output, StringFormat=N0}" Width="0.9*" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
