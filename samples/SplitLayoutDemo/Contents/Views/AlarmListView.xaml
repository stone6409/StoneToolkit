<UserControl x:Class="SplitLayoutDemo.Contents.Views.AlarmListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataGrid x:Name="AlarmGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              FontSize="12"
              RowHeaderWidth="0">
        <DataGrid.Columns>
            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="0.9*" />
            <DataGridTextColumn Header="等级" Binding="{Binding Level}" Width="0.6*" />
            <DataGridTextColumn Header="报警内容" Binding="{Binding Message}" Width="2.4*" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
