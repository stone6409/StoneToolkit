<Window x:Class="MessengerWpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messenger WPF 示例" Height="420" Width="680">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：发布区 -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="发布区" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />

            <TextBlock Text="消息文本：" Margin="0,0,0,4" />
            <TextBox Text="{Binding Publisher.MessageText, UpdateSourceTrigger=PropertyChanged}"
                     Height="28" Margin="0,0,0,12" />

            <Button Content="发送消息" Command="{Binding Publisher.SendCommand}"
                    Height="32" Padding="8,0" Margin="0,0,0,12" />

            <TextBlock Text="提示：直接输入任意文本将广播给「广播订阅者」。
以 A: / B: 开头则定向发给对应「通道A订阅者」/「通道B订阅者」（演示 token 细分）。"
                       TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
        </StackPanel>

        <!-- 右侧：订阅区 -->
        <ListBox Grid.Column="1" ItemsSource="{Binding Subscribers}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding ReceivedMessage}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
