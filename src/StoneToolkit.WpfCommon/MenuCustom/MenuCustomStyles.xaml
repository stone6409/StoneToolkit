<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:StoneToolkit.WpfCommon.MenuCustom">

    <local:MenuItemContainerTemplateSelector x:Key="MenuItemContainerTemplateSelector" />

    <Style x:Key="CustomSeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="30,0,0,0" />
        <Setter Property="Background" Value="LightGray" />
    </Style>

    <DataTemplate x:Key="CommandMenuItemTemplate" DataType="{x:Type local:CommandMenuItem}">
        <MenuItem Header="{Binding Header}" Command="{Binding Command}" InputGestureText="{Binding InputGestureText}" ItemsSource="{Binding Path=SubMenuItems}" UsesItemContainerTemplate="True" ItemContainerTemplateSelector="{StaticResource MenuItemContainerTemplateSelector}" />
    </DataTemplate>

    <DataTemplate x:Key="SeparatorItemTemplate" DataType="{x:Type local:SeparatorItem}">
        <Separator Style="{StaticResource CustomSeparatorStyle}" />
    </DataTemplate>

</ResourceDictionary>