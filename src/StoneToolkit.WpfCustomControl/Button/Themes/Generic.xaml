<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uicontrol="clr-namespace:StoneToolkit.WpfControl;assembly=StoneToolkit.WpfControl"
                    xmlns:local="clr-namespace:StoneToolkit.WpfCustomControl.Button">

    <ControlTemplate x:Key="ButtonOverlay" TargetType="{x:Type local:Button}">
        <Button>
            <Grid>
                <uicontrol:AutoGrayableImage Source="{TemplateBinding Image}" />
                <TextBlock Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Text}" TextDecorations="{TemplateBinding TextDecorations}" Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Button>
    </ControlTemplate>

    <ControlTemplate x:Key="ButtonImageAboveText" TargetType="{x:Type local:Button}">
        <Button>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <uicontrol:AutoGrayableImage Source="{TemplateBinding Image}" />
                <TextBlock Grid.Row="1" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Text}" TextDecorations="{TemplateBinding TextDecorations}" Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Button>
    </ControlTemplate>

    <ControlTemplate x:Key="ButtonTextAboveImage" TargetType="{x:Type local:Button}">
        <Button>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Text}" />
                <uicontrol:AutoGrayableImage Grid.Row="1" Source="{TemplateBinding Image}" />
            </Grid>
        </Button>
    </ControlTemplate>

    <ControlTemplate x:Key="ButtonImageBeforeText" TargetType="{x:Type local:Button}">
        <Button>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <uicontrol:AutoGrayableImage Source="{TemplateBinding Image}" />
                <TextBlock Grid.Column="1" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Text}" />
            </Grid>
        </Button>
    </ControlTemplate>

    <ControlTemplate x:Key="ButtonTextBeforeImage" TargetType="{x:Type local:Button}">
        <Button>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Text}" />
                <uicontrol:AutoGrayableImage Grid.Column="1" Source="{TemplateBinding Image}" />
            </Grid>
        </Button>
    </ControlTemplate>

    <Style TargetType="{x:Type local:Button}">
        <Setter Property="Template" Value="{StaticResource ButtonOverlay}" />
        <Style.Triggers>
            <Trigger Property="TextImageRelation" Value="ImageAboveText">
                <Setter Property="Template" Value="{StaticResource ButtonImageAboveText}" />
            </Trigger>
            <Trigger Property="TextImageRelation" Value="TextAboveImage">
                <Setter Property="Template" Value="{StaticResource ButtonTextAboveImage}" />
            </Trigger>
            <Trigger Property="TextImageRelation" Value="ImageBeforeText">
                <Setter Property="Template" Value="{StaticResource ButtonImageBeforeText}" />
            </Trigger>
            <Trigger Property="TextImageRelation" Value="TextBeforeImage">
                <Setter Property="Template" Value="{StaticResource ButtonTextBeforeImage}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>