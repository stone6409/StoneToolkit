<UserControl x:Class="StoneToolkit.Extension.Tray.CustomBalloon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StoneToolkit.Extension.Tray"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="Black" MaxWidth="320" MinWidth="240" MinHeight="160">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
        <Grid Margin="5,5" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,5">
                <Image Source="{StaticResource AppImage}" Width="16" Height="16" />
                <TextBlock Text="{Binding Title}" Margin="5,0,0,0" Foreground="White" />
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="TitleTextBlock" Text="{Binding BalloonTitle}" FontWeight="Bold" Foreground="White">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BalloonTitle}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Row="2" Text="{Binding BalloonText}" Margin="0,5,0,0" Foreground="White" TextWrapping="Wrap" />
            <Button Grid.Row="3" Content="Close" Click="CloseButton_Click" HorizontalAlignment="Center" Width="60" Margin="0,10,0,0"/>
        </Grid>
    </Border>
</UserControl>
