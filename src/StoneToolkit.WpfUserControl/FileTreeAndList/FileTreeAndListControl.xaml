<UserControl x:Class="StoneToolkit.WpfUserControl.FileTreeAndList.FileTreeAndListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StoneToolkit.WpfUserControl.FileTreeAndList"
             xmlns:FileSystemNodes="clr-namespace:StoneToolkit.WpfUserControl.FileSystemNodes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/StoneToolkit.WpfCommon;component/TreeViewCustom/TreeViewCustomStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/StoneToolkit.WpfCommon;component/Styles/ImageDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="GridViewColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- 左侧文件夹树 -->
        <TreeView x:Name="FileTreeView" ItemsSource="{Binding RootFolderNode.Folders, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                  SelectedItemChanged="TreeView_SelectedItemChanged">
            <TreeView.Resources>
                <!-- 文件夹模板 -->
                <HierarchicalDataTemplate DataType="{x:Type FileSystemNodes:FolderNode}" ItemsSource="{Binding Folders}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource FolderImage}" Width="16" Height="16" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>

        <!-- 分隔线 -->
        <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" ShowsPreview="True" Width="4" />

        <!-- 右侧文件列表 -->
        <ListView x:Name="FileListView" Grid.Column="2" ItemsSource="{Binding Files, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                  SelectionMode="Single" MouseDoubleClick="FileListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="400">
                        <GridViewColumnHeader>
                            <TextBlock Text="文件" TextAlignment="Left" />
                        </GridViewColumnHeader>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextAlignment="Left" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>