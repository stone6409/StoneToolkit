<UserControl x:Class="StoneToolkit.WpfUserControl.LogViewer.View.LogMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StoneToolkit.WpfUserControl.LogViewer.View"
             xmlns:converters="clr-namespace:StoneToolkit.WpfUserControl.LogViewer.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/StoneToolkit.WpfCommon;component/Styles/ImageDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:LevelToImageConverter x:Key="LevelToImageConverter" />

            <Style TargetType="DataGrid">
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="CanUserResizeRows" Value="false"/>
                <Setter Property="CanUserAddRows" Value="false"/>
                <Setter Property="AutoGenerateColumns" Value="false"/>
                <Setter Property="CanUserReorderColumns" Value="false"/>
                <Setter Property="ClipboardCopyMode" Value="None"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="RowHeight" Value="25" />
            </Style>

            <Style TargetType="TextBlock" x:Key="DataGridTextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="5,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding Command="local:LogMessageControl.CopyCommand" Executed="CopyExecute" CanExecute="CanCopyExecute"/>
        <CommandBinding Command="local:LogMessageControl.ClearCommand" Executed="ClearExecute" CanExecute="CanClearExecute"/>
        <CommandBinding Command="local:LogMessageControl.FiltersCommand" Executed="FiltersExecute" CanExecute="CanFiltersExecute"/>
    </UserControl.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBar Loaded="ToolBar_Loaded">
            <Button Height="22" ToolTip="清除日志" Command="local:LogMessageControl.ClearCommand">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource ClearImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">清除</TextBlock>
                </StackPanel>
            </Button>
            <Separator />
            <ToggleButton IsChecked="{Binding Path=LogLevelFilterList.TraceLevelFilter.Enabled, Mode=TwoWay}" Margin="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource TraceImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">跟踪</TextBlock>
                </StackPanel>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding Path=LogLevelFilterList.DebugLevelFilter.Enabled, Mode=TwoWay}" Margin="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource DebugImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">调试</TextBlock>
                </StackPanel>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding Path=LogLevelFilterList.InfoLevelFilter.Enabled, Mode=TwoWay}" Margin="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource InfoImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">信息</TextBlock>
                </StackPanel>
            </ToggleButton>
            <Separator />
            <ToggleButton IsChecked="{Binding Path=LogLevelFilterList.WarnLevelFilter.Enabled, Mode=TwoWay}" Margin="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource WarnImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">警告</TextBlock>
                </StackPanel>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding Path=LogLevelFilterList.ErrorLevelFilter.Enabled, Mode=TwoWay}" Margin="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource ErrorImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">错误</TextBlock>
                </StackPanel>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding Path=LogLevelFilterList.FatalLevelFilter.Enabled, Mode=TwoWay}" Margin="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource FatalImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">致命</TextBlock>
                </StackPanel>
            </ToggleButton>
            <Separator />
            <Button Height="22" ToolTip="规则过滤器" Command="local:LogMessageControl.FiltersCommand" CommandTarget="{Binding ElementName=LogDataGrid}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource FilterImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">过滤器</TextBlock>
                </StackPanel>
            </Button>
            <ListBox x:Name="FilterList" ItemsSource="{Binding}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton IsChecked="{Binding Path=Enabled, Mode=TwoWay}" Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Margin="2,0,0,0"></TextBlock>
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </ToolBar>

        <DataGrid Name="LogDataGrid" Grid.Row="1" ItemsSource="{Binding ShowLogMessages}" AutoGenerateColumns="False" CanUserAddRows="false" IsReadOnly="True" SelectionMode="Single" Sorting="DataGrid_Sorting">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制" Command="local:LogMessageControl.CopyCommand">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource CopyImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="清空" Command="local:LogMessageControl.ClearCommand">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ClearImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="跟踪" IsCheckable="True" IsChecked="{Binding Path=LogLevelFilterList.TraceLevelFilter.Enabled, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource TraceImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="调试" IsCheckable="True" IsChecked="{Binding Path=LogLevelFilterList.DebugLevelFilter.Enabled, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource DebugImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="信息" IsCheckable="True" IsChecked="{Binding Path=LogLevelFilterList.InfoLevelFilter.Enabled, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource InfoImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="警告" IsCheckable="True" IsChecked="{Binding Path=LogLevelFilterList.WarnLevelFilter.Enabled, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource WarnImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="错误" IsCheckable="True" IsChecked="{Binding Path=LogLevelFilterList.ErrorLevelFilter.Enabled, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ErrorImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="致命" IsCheckable="True" IsChecked="{Binding Path=LogLevelFilterList.FatalLevelFilter.Enabled, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource FatalImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="级别" SortMemberPath="Level" MinWidth="60" Width="60">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="16" Height="16" HorizontalAlignment="Center">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource LevelToImageConverter}">
                                        <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Mode="OneTime"/>
                                        <Binding Path="Level" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="时间" SortMemberPath="Time" MinWidth="80" Width="160">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Center" Style="{StaticResource DataGridTextBlock}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="消息" SortMemberPath="Message" MinWidth="80" Width="480">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" HorizontalAlignment="Left" Style="{StaticResource DataGridTextBlock}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
