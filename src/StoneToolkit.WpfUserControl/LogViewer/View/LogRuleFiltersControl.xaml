<UserControl x:Class="StoneToolkit.WpfUserControl.LogViewer.View.LogRuleFiltersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:CommonMisc="clr-namespace:StoneToolkit.WpfCommon.Misc;assembly=StoneToolkit.WpfCommon"
             xmlns:local="clr-namespace:StoneToolkit.WpfUserControl.LogViewer.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/StoneToolkit.WpfCommon;component/DataGridCustom/DataGridCustomStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/StoneToolkit.WpfCommon;component/Styles/ImageDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding Command="CommonMisc:DataGridComands.Add" Executed="AddCommandExecute" CanExecute="CanAddCommandExecute"></CommandBinding>
        <CommandBinding Command="CommonMisc:DataGridComands.Insert" Executed="InsertCommandExecute" CanExecute="CanInsertCommandExecute"></CommandBinding>
        <CommandBinding Command="CommonMisc:DataGridComands.Delete" Executed="DeleteCommandExecute" CanExecute="CanDeleteCommandExecute"></CommandBinding>
    </UserControl.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBar Loaded="ToolBar_Loaded">
            <Button Height="22" ToolTip="添加" Command="CommonMisc:DataGridComands.Add" CommandTarget="{Binding ElementName=DataGrid}" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource AddImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">添加</TextBlock>
                </StackPanel>
            </Button>
            <Button Height="22" ToolTip="插入" Command="CommonMisc:DataGridComands.Insert" CommandTarget="{Binding ElementName=DataGrid}" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource InsertImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">插入</TextBlock>
                </StackPanel>
            </Button>
            <Button Height="22" ToolTip="删除" Command="CommonMisc:DataGridComands.Delete" CommandTarget="{Binding ElementName=DataGrid}" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource RemoveImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">删除</TextBlock>
                </StackPanel>
            </Button>
        </ToolBar>
        <DataGrid Name="DataGrid" Grid.Row="1" ItemsSource="{Binding LogRuleFilterViewModels}" LoadingRow="DataGrid_LoadingRow" Sorting="DataGrid_Sorting" CanUserSortColumns="True">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="名称" SortMemberPath="Name" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="5,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="启用" SortMemberPath="Enabled" Width="60">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="表达式" SortMemberPath="Expression" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Expression}" Margin="5,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Expression, UpdateSourceTrigger=LostFocus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="描述" SortMemberPath="Description" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}" Margin="5,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>