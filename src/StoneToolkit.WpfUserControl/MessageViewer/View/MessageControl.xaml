<UserControl x:Class="StoneToolkit.WpfUserControl.MessageViewer.View.MessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:StoneToolkit.WpfUserControl.MessageViewer.Converters"
             xmlns:local="clr-namespace:StoneToolkit.WpfUserControl.MessageViewer.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/StoneToolkit.WpfCommon;component/Styles/ImageDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="DataGrid">
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="CanUserResizeRows" Value="false"/>
                <Setter Property="CanUserAddRows" Value="false"/>
                <Setter Property="AutoGenerateColumns" Value="false"/>
                <Setter Property="CanUserReorderColumns" Value="false"/>
                <Setter Property="ClipboardCopyMode" Value="None"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="RowHeight" Value="25" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style TargetType="TextBlock" x:Key="DataGridTextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="5,0" />
            </Style>

            <converter:LevelToImageConverter x:Key="LevelToImageConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding Command="local:MessageControl.CopyCommand" Executed="CopyExecute" CanExecute="CanCopyExecute" />
        <CommandBinding Command="local:MessageControl.ClearCommand" Executed="ClearExecute" CanExecute="CanClearExecute" />
    </UserControl.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBar Loaded="ToolBar_Loaded">
            <Button Height="22" ToolTip="清空消息" Command="local:MessageControl.ClearCommand" CommandTarget="{Binding ElementName=dataGrid}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource ClearImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">清空</TextBlock>
                </StackPanel>
            </Button>
            <Separator />
            <ToggleButton IsChecked="{Binding Path=LogLevelFilterList.InfoLevelFilter.Enabled, Mode=TwoWay}" Margin="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource InfoImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">信息</TextBlock>
                </StackPanel>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding Path=LogLevelFilterList.WarnLevelFilter.Enabled, Mode=TwoWay}" Margin="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource WarnImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">警告</TextBlock>
                </StackPanel>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding Path=LogLevelFilterList.ErrorLevelFilter.Enabled, Mode=TwoWay}" Margin="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource ErrorImage}" Width="16" Height="16"/>
                    <TextBlock Margin="2,0,0,0">错误</TextBlock>
                </StackPanel>
            </ToggleButton>
        </ToolBar>

        <DataGrid Name="dataGrid" Grid.Row="1" ItemsSource="{Binding ShowMessages}" MouseDoubleClick="DataGrid_MouseDoubleClick" IsReadOnly="True" Sorting="DataGrid_Sorting">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制" Command="local:MessageControl.CopyCommand">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource CopyImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="清空" Command="local:MessageControl.ClearCommand">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ClearImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="信息" IsCheckable="True" IsChecked="{Binding Path=LogLevelFilterList.InfoLevelFilter.Enabled, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource InfoImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="警告" IsCheckable="True" IsChecked="{Binding Path=LogLevelFilterList.WarnLevelFilter.Enabled, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource WarnImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="错误" IsCheckable="True" IsChecked="{Binding Path=LogLevelFilterList.ErrorLevelFilter.Enabled, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ErrorImage}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="级别" SortMemberPath="Level" MinWidth="60" Width="60">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Width="16" Height="16" HorizontalAlignment="Center">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource LevelToImageConverter}">
                                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Mode="OneTime"/>
                                            <Binding Path="Level" />
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                                <TextBlock Text="{Binding LevelText}" Style="{StaticResource DataGridTextBlock}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="时间" SortMemberPath="Time" MinWidth="80" Width="160">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Center" Style="{StaticResource DataGridTextBlock}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="类别" SortMemberPath="Category" MinWidth="80" Width="120">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Category}" HorizontalAlignment="Left" Style="{StaticResource DataGridTextBlock}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="内容" SortMemberPath="Content" MinWidth="160" Width="960">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Content}" HorizontalAlignment="Left" Style="{StaticResource DataGridTextBlock}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
