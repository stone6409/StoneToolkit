<UserControl x:Class="StoneToolkit.WpfUserControl.FileTree.FileTreeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tvcustom="clr-namespace:StoneToolkit.WpfCommon.TreeViewCustom;assembly=StoneToolkit.WpfCommon"
             xmlns:FileSystemNodes="clr-namespace:StoneToolkit.WpfUserControl.FileSystemNodes"
             xmlns:local="clr-namespace:StoneToolkit.WpfUserControl.FileTree"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/StoneToolkit.WpfCommon;component/TreeViewCustom/TreeViewCustomStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/StoneToolkit.WpfCommon;component/Styles/ImageDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <TreeView x:Name="TreeView" ItemsSource="{Binding Children}" 
              ItemContainerStyle="{StaticResource TreeItemContainerStyle}" 
              SelectedItemChanged="TreeView_SelectedItemChanged">
        <TreeView.Resources>
            <!-- 文件夹模板 -->
            <HierarchicalDataTemplate DataType="{x:Type FileSystemNodes:FolderNode}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource FolderImage}" Width="16" Height="16" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </HierarchicalDataTemplate>

            <!-- 文件模板 -->
            <DataTemplate DataType="{x:Type FileSystemNodes:FileNode}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource FileImage}" Width="16" Height="16" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </TreeView.Resources>
    </TreeView>
</UserControl>